{
  // The shipped artifact: JavaScript in lib/ and declarations in lib/types/,
  // the layout the package `exports` map names. `rewriteRelativeImportExtensions`
  // turns the source's `./admission.ts` specifiers into `./admission.js` on
  // emit, so no bundler is involved in producing a loadable plugin.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "lib",
    "declarationDir": "lib/types",
    "declarationMap": false,
    "sourceMap": false
  },
  "include": ["src/**/*.ts"]
}
